=head1 NAME

deb-systemd-invoke - wrapper around systemctl, respecting policy-rc.d

=head1 SYNOPSIS

B<deb-systemd-invoke> [B<--user>] [B<--[no-]deferred>] start|stop|restart|try-restart|reload S<I<unit file> ...>
B<deb-systemd-invoke> [B<--user>] [B<--no-dbus>] daemon-reload|daemon-reexec|enqueue-marked-jobs

=head1 DESCRIPTION

B<deb-systemd-invoke> is a Debian-specific helper script which asks
/usr/sbin/policy-rc.d before performing a systemctl call.

B<deb-systemd-invoke> is intended to be used from maintscripts to manage
systemd unit files. It is specifically NOT intended to be used interactively by
users. Instead, users should run systemd and use systemctl, or not bother about
the systemd enabled state in case they are not running systemd.

When B<--deferred> is used, the requested actions will be enqueued, and
a separate B<enqueue-marked-jobs> action will be required to execute them.
Note that this will automatically fallback to immediate execution in case the
running systemd version is too old to support the required APIs, in which case
B<enqueue-marked-jobs> will be a no-op.

=cut

use strict;
use warnings;
use Config;
use Getopt::Long; # in core since Perl 5
use IO::Socket::UNIX; # in core since at least Perl 5.6.1-8.9

if (@ARGV < 1) {
    print STDERR "Syntax: $0 <action> [<unit file> [<unit file> ...]]\n";
    exit 1;
}

my $is_system = 1;
my $use_dbus = 1;
my $deferred = 0;
my $result = GetOptions(
    "user" => sub { $is_system = 0; },
    "system" => sub { $is_system = 1; }, # default
    "no-dbus" => sub { $use_dbus = 0; },
    "deferred" => sub { $deferred = 1; },
    "no-deferred" => sub { $deferred = 0; },
);

# Varlink methods are very new, so check if the sockets and the methods are available
# to allow graceful fallbacks to older IPCs. Returns true when the calls could be made,
# false otherwise. This implementation must only use core Perl, and no external programs,
# to be self-contained and safe against apt ordering bugs.
sub varlink_get_sockets {
    return ('/run/systemd/io.systemd.Manager') if $is_system;

    # For each <UID> directory under /run/user/ check if the systemd/io.systemd.Manager socket exists
    opendir(my $dh, '/run/user/') or return;
    my @sockets =
        grep { -S $_ }
        map { "/run/user/$_/systemd/io.systemd.Manager" }
        grep { !/^\./ }
        readdir($dh);
    closedir($dh);

    return @sockets;
}

sub varlink_connect {
    my ($socket) = @_;

    my $client = IO::Socket::UNIX->new(
        Type    => SOCK_STREAM,
        Peer    => $socket,
        Timeout => 30,
    ) or return;

    $client->setsockopt(SOL_SOCKET, SO_RCVTIMEO, pack('l!l!', 30, 0)) or die "Failed to set socket receive timeout: $!";
    $client->setsockopt(SOL_SOCKET, SO_SNDTIMEO, pack('l!l!', 30, 0)) or die "Failed to set socket send timeout: $!";

    return $client;
}

sub varlink_send_and_receive {
    my ($client, $method, $parameters) = @_;

    print $client qq|{"method":"$method","parameters":$parameters}\0|;
    local $/ = "\0"; # set input record separator to null byte as per varlink protocol
    my $response = <$client>;

    return $response;
}

sub varlink_interface_has_method {
    my ($socket, $interface, $method) = @_;

    my $client = varlink_connect($socket) or return;

    my $response = varlink_send_and_receive($client, 'org.varlink.service.GetInterfaceDescription', qq|{"interface":"$interface"}|);
    close $client;

    return if not defined $response or $response !~ /method\s+$method\s*\(/;
    return 1;
}

sub varlink_method_invoke {
    my ($qualified_method, $parameters) = @_;

    # Split qualified method into interface and method name (e.g., "io.systemd.Manager.Reload" -> "io.systemd.Manager" and "Reload")
    my ($interface, $method) = $qualified_method =~ /^(.+)\.([^.]+)$/;
    die("Invalid qualified method: $qualified_method")
        if not defined $interface or not defined $method;

    my @sockets = varlink_get_sockets() or return;

    # First check to see if the interface supports the method
    return if not varlink_interface_has_method($sockets[0], $interface, $method);

    foreach my $socket (@sockets) {
        my $client = varlink_connect($socket) or return;
        my $response = varlink_send_and_receive($client, $qualified_method, $parameters);
        close $client;

        # Reexecute causes the socket to be closed with no response on reexec
        return if
            (not defined $response and $method ne "Reexecute") or
            (defined $response and $response =~ /"error"\s*:/);
    }

    return 1;
}

sub action_to_marker {
    my ($action) = @_;

    if ($action eq "start") {
        return '+needs-start';
    } elsif ($action eq "restart") {
        return '+needs-restart';
    } elsif ($action eq "try-restart") {
        return '+needs-restart';
    } elsif ($action eq "stop") {
        return '+needs-stop';
    } elsif ($action eq "reload") {
        return '+needs-reload';
    } else {
        die("Invalid action for deferred start/restart/try-restart/stop/reload: $action");
    }
}

# Returns the effective action for a unit, or undef if the unit should be skipped.
# If the unit is not active and restart is requested, returns 'start' instead.
sub get_effective_action {
    my ($unit, $unit_installed, $unit_active, $action) = @_;

    if (not $unit_installed and $action eq "start") {
        print STDERR "$unit is a disabled or a static unit, not starting it.\n";
        return;
    } elsif (not $unit_installed and not $unit_active and ($action eq "restart" or $action eq "try-restart" or $action eq "reload")) {
        print STDERR "$unit is a disabled or a static unit not running, skipping $action.\n";
        return;
    } elsif (not $unit_active and $action eq "try-restart") {
        return;
    } elsif (not $unit_active and $action eq "restart") {
        # unit is not active, change action to 'start', as 'restart' will be a no-op
        return "start";
    } else {
        return $action;
    }
}

sub get_instances {
    return ('system') if $is_system;

    # '--machine <ID>@' was added in v250 and v249.10, before that we can't talk to arbitrary user instances
    my $systemctl_version = `systemctl --version --quiet`;
    $systemctl_version =~ s/.*^systemd (\S+) \(.*/$1/ms;
    if (system('dpkg', '--compare-versions', $systemctl_version, 'ge', '249') != 0) {
        print STDERR "systemctl version $systemctl_version does not support acting on user instance, skipping\n";
        return;
    }

    # Each user instance of the manager has a corresponding user@<id>.service unit.
    # Get the full list of IDs, so that we can talk to each user instance to start/stop
    # user units.
    return map { s/^\s*user\@(\d+)\.service\s.*/$1/sr }
        `systemctl --no-legend --quiet list-units 'user@*'`;
}

sub start_restart_stop_dbus {
    my ($action, @units) = @_;

    my @instances = get_instances();
    foreach my $instance (@instances) {
        my @instance_args;
        my @start_unit_markers;

        if ($instance eq 'system') {
            push(@instance_args, '--system');
        } else {
            push(@instance_args, '--user', '--machine', "$instance@");
        }

        for my $unit (@units) {
            my $unit_installed = 0;
            my $enabled_output = `systemctl @instance_args is-enabled -- '$unit'`;
            # matching enabled and enabled-runtime as an installed non static unit
            if ($enabled_output =~ /enabled/) {
                $unit_installed = 1;
            }
            system('systemctl', @instance_args, '--quiet', 'is-active', '--', $unit);
            die "Could not execute systemctl: $!\n" if $? == -1;
            die "systemctl died with signal " . ($? & 127) . "!\n" if $? & 127;
            my $unit_active = $?>>8 == 0 ? 1 : 0;
            my $effective_action = get_effective_action($unit, $unit_installed, $unit_active, $action);
            if (defined $effective_action) {
                push(@start_unit_markers, [$unit, $effective_action]);
            }
        }

        if (@start_unit_markers) {
            if (not $deferred) {
                # Group units by action for non-deferred execution
                my %units_by_action;
                foreach my $unit_marker (@start_unit_markers) {
                    my ($unit, $unit_action) = @$unit_marker;
                    push(@{$units_by_action{$unit_action}}, $unit);
                }
                foreach my $unit_action (keys %units_by_action) {
                    system('systemctl', '--quiet', @instance_args, $unit_action, @{$units_by_action{$unit_action}});
                    die "Could not execute systemctl: $!\n" if $? == -1;
                    die "systemctl died with signal " . ($? & 127) . "!\n" if $? & 127;
                    die "systemctl returned status " . ($? >> 8) . "!\n" if $? >> 8;
                }
            } else {
                foreach my $unit_marker (@start_unit_markers) {
                    my ($unit, $unit_action) = @$unit_marker;
                    my $marker = action_to_marker($unit_action);
                    # Quietly fallback to immediate execution if the above failed (e.g., because the systemd version is too old)
                    if (system('systemctl', '--quiet', @instance_args, 'set-property', $unit, "Markers=$marker") != 0) {
                        system('systemctl', '--quiet', @instance_args, $unit_action, $unit);
                        die "Could not execute systemctl: $!\n" if $? == -1;
                        die "systemctl died with signal " . ($? & 127) . "!\n" if $? & 127;
                        die "systemctl returned status " . ($? >> 8) . "!\n" if $? >> 8;
                    }
                }
            }
        }
    }

    return;
}

sub start_restart_stop_varlink {
    my ($action, @units) = @_;

    return if not $deferred;

    my @sockets = varlink_get_sockets() or return;

    # First check to see if the interface supports the method
    return if not varlink_interface_has_method($sockets[0], 'io.systemd.Unit', 'SetProperties');

    foreach my $socket (@sockets) {
        my $client = varlink_connect($socket) or return;
        my @start_unit_markers;

        for my $unit (@units) {
            my $response = varlink_send_and_receive($client, 'io.systemd.Unit.List', qq|{"name":"$unit"}|);
            if (not defined $response or $response =~ /"error"\s*:/) {
                close($client);
                return;
            }

            my $unit_installed = 0;
            # matching enabled and enabled-runtime as an installed non static unit
            if ($response =~ /"UnitFileState"\s*:\s*"enabled/) {
                $unit_installed = 1;
            }
            my $unit_active = 0;
            if ($response =~ /"ActiveState"\s*:\s*"active"/) {
                $unit_active = 1;
            }
            my $effective_action = get_effective_action($unit, $unit_installed, $unit_active, $action);
            if (defined $effective_action) {
                push(@start_unit_markers, [$unit, action_to_marker($effective_action)]);
            }
        }
        foreach my $unit_marker (@start_unit_markers) {
            my ($unit, $marker) = @$unit_marker;
            my $response = varlink_send_and_receive($client, 'io.systemd.Unit.SetProperties', qq|{"runtime": true, "name": "$unit", "properties": {"Markers": ["$marker"]}}|);
            if (not defined $response or $response =~ /"error"\s*:/) {
                close($client);
                return;
            }
        }

        close($client);
    }

    system('dpkg-trigger', 'systemd-enqueue-marked-jobs') == 0 or print STDERR "could not trigger systemd-enqueue-marked-jobs dpkg trigger, units will not be acted upon\n";

    return 1;
}

sub do_start_restart_stop {
    my ($action, @units) = @_;

    if (start_restart_stop_varlink($action, @units)) {
        return;
    } else {
        start_restart_stop_dbus($action, @units);
    }

    return;
}

sub reload_reexec_dbus {
    my ($action) = @_;

    my @instances = get_instances();
    foreach my $instance (@instances) {
        if ($instance eq 'system') {
            system('systemctl', '--quiet', '--system', $action);
        } else {
            system('systemctl', '--quiet', '--user', '--machine', "$instance@", $action);
        }
    }

    return;
}

my $SIGRTMIN = 0;
for my $name (split(' ', $Config{sig_name})) {
    last if ($name eq "RTMIN");
    $SIGRTMIN++;
}

sub reload_reexec_signal {
    my ($action) = @_;
    my $signal;

    if ($action eq "daemon-reload") {
        $signal = 'SIGHUP';
    } else {
        # Perl kill() does not recognize SIGRTMIN+n
        $signal = $is_system ? ($SIGRTMIN + 25) : 'SIGRTMIN+25';
    }

    if ($is_system) {
        kill($signal, 1);
    } else {
        system('systemctl', '--quiet', 'kill', '--kill-whom=main', '--signal', $signal, 'user@*.service');
    }

    return;
}

sub reload_reexec_varlink {
    my ($action) = @_;

    if ($action eq "daemon-reload") {
        return varlink_method_invoke('io.systemd.Manager.Reload', '{}');
    } elsif ($action eq "daemon-reexec") {
        return varlink_method_invoke('io.systemd.Manager.Reexecute', '{}');
    } else {
        die("Invalid action for varlink reload/reexec: $action");
    }
}

sub do_reload_reexec {
    my ($action) = @_;

    return if $ENV{DPKG_ROOT};

    # Prefer varlink, as it can be used with no external dependencies
    # and it's thus safe against apt ordering bugs
    if (reload_reexec_varlink($action)) {
        return;
    } elsif ($use_dbus) {
        reload_reexec_dbus($action);
    } else {
        reload_reexec_signal($action);
    }

    return;
}

sub do_enqueue_marked_jobs {
    my ($action) = @_;

    die("Invalid action for enqueue-marked-jobs: $action")
        if $action ne "enqueue-marked-jobs";

    return if $ENV{DPKG_ROOT};

    # Prefer varlink, as it can be used with no external dependencies
    # and it's thus safe against apt ordering bugs
    if (varlink_method_invoke('io.systemd.Manager.EnqueueMarkedJobs', '{}')) {
        return;
    }

    my @instances = get_instances();
    foreach my $instance (@instances) {
        if ($instance eq 'system') {
            system('systemctl', '--quiet', '--system', "reload-or-restart", "--marked");
        } else {
            system('systemctl', '--quiet', '--user', '--machine', "$instance@", "reload-or-restart", "--marked");
        }
    }

    return;
}

my $policyhelper = '/usr/sbin/policy-rc.d';
$policyhelper = $ENV{DPKG_ROOT} . $policyhelper if $ENV{DPKG_ROOT};
my @units = @ARGV;
my $action = shift @units;
if (-x $policyhelper) {
    foreach my $unit (@units) {
        system(qq|$policyhelper $unit "$action"|);
        die "Could not execute $policyhelper: $!\n" if $? == -1;
        die "$policyhelper died with signal " . ($? & 127) . "!\n" if $? & 127;

        # 0 or 104 means run
        # 101 means do not run
        my $exitcode = ($? >> 8);
        if ($exitcode == 101) {
            print STDERR "$policyhelper returned 101, not running '" . join(' ', @ARGV) . "'\n";
            exit 0;
        } elsif ($exitcode != 104 && $exitcode != 0) {
            print STDERR "deb-systemd-invoke only supports $policyhelper return codes 0, 101, and 104!\n";
            print STDERR "Got return code $exitcode, ignoring.\n";
        }
    }
}

# If the job is disabled and is not currently running, the job is not started or restarted.
# However, if the job is disabled but has been forced into the running state, we *do* stop
# and restart it since this is expected behaviour for the admin who forced the start.
# We don't autostart static units either.
if ($action eq "start" or $action eq "restart" or $action eq "try-restart" or $action eq "stop" or $action eq "reload") {
    do_start_restart_stop($action, @units);
} elsif ($action eq "daemon-reload" or $action eq "daemon-reexec") {
    do_reload_reexec($action);
} elsif ($action eq "enqueue-marked-jobs") {
    do_enqueue_marked_jobs($action);
} else {
    exec('systemctl', @ARGV);
}
